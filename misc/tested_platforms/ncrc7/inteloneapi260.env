#
module unload cray-mpich hdf5 netcdf-c netcdf-fortran
module unload intel-oneapi-mkl oneapi
#module load oneapi/2025.3.1 cray-mpich/9.2.0
module load oneapi/2026.0.0 mpich/5.0.1
module load hdf5/1.14.6 netcdf-c/4.10.0 netcdf-fortran/4.6.2
setenv LD_LIBRARY_PATH ${NETCDF_DIR}/lib:${HDF5_DIR}/lib:${LD_LIBRARY_PATH}
LD_LIBRARY_PATH=${NETCDF_DIR}/lib:${HDF5_DIR}/lib:${LD_LIBRARY_PATH}
module unload darshan-runtime
module list
setenv KMP_STACKSIZE 512m
export KMP_STACKSIZE=512m
setenv NC_BLKSZ 1M
export NC_BLKSZ=1M
# HPE workaround to avoid MPI_Finalize crash (2024-10)
setenv FI_VERBS_PREFER_XRC 0
export FI_VERBS_PREFER_XRC=0

export CC=mpicc
export FC=mpif90
export LD=mpif90
$FC --version

